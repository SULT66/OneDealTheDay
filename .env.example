PORT=8088
SITE_URL=http://localhost:8088
# Set real secrets only in the hosting provider's encrypted app settings.
# Generate ADMIN_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=
DATA_DIR=
# eBay Marketplace Account Deletion compliance endpoint
# Generate EBAY_VERIFICATION_TOKEN with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EBAY_VERIFICATION_TOKEN=
EBAY_ACCOUNT_DELETION_ENDPOINT=https://www.onedailydrop.com/api/ebay/account-deletion
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
EBAY_ENVIRONMENT=production
AFFILIATE_TAG=
AFFILIATE_TAG_US=
AFFILIATE_TAG_CA=
AFFILIATE_TAG_UK=
AFFILIATE_TAG_FR=
AFFILIATE_TAG_DE=
RAINFOREST_API_KEY=
BLUECART_API_KEY=
# Required with BLUECART_API_KEY so Walmart links remain commissionable.
# Supported placeholders: {url} (encoded), {rawUrl}, {id}.
WALMART_AFFILIATE_URL_TEMPLATE_US=
WALMART_AFFILIATE_URL_TEMPLATE_CA=

# Approved affiliate product feeds. Each configured HTTPS URL activates that
# store and market automatically. FORMAT may be auto, json, csv, tsv or xml.
# Optional *_HEADERS_JSON and *_FIELD_MAP_JSON belong in encrypted app settings.
# Future stores can be added without code through AFFILIATE_FEEDS_JSON.
AFFILIATE_FEEDS_JSON=
AFFILIATE_FEED_WALMART_US_URL=
AFFILIATE_FEED_WALMART_CA_URL=
AFFILIATE_FEED_TARGET_US_URL=
AFFILIATE_FEED_BEST_BUY_US_URL=
AFFILIATE_FEED_BEST_BUY_CA_URL=
AFFILIATE_FEED_HOME_DEPOT_US_URL=
AFFILIATE_FEED_HOME_DEPOT_CA_URL=
AFFILIATE_FEED_LOWES_US_URL=
AFFILIATE_FEED_LOWES_CA_URL=
AFFILIATE_FEED_WAYFAIR_US_URL=
AFFILIATE_FEED_WAYFAIR_CA_URL=
AFFILIATE_FEED_WAYFAIR_UK_URL=
AFFILIATE_FEED_WAYFAIR_DE_URL=
AFFILIATE_FEED_ALIEXPRESS_US_URL=
AFFILIATE_FEED_ALIEXPRESS_CA_URL=
AFFILIATE_FEED_ALIEXPRESS_UK_URL=
AFFILIATE_FEED_ALIEXPRESS_FR_URL=
AFFILIATE_FEED_ALIEXPRESS_DE_URL=
# Mooncool Awin Create-a-Feed URLs must include aw_deep_link and use a
# market-specific currency. Keep these signed URLs only in Azure app settings.
AFFILIATE_FEED_MOONCOOL_US_URL=
AFFILIATE_FEED_MOONCOOL_CA_URL=
AFFILIATE_FEED_CURRYS_UK_URL=
AFFILIATE_FEED_AO_UK_URL=
AFFILIATE_FEED_FNAC_FR_URL=
AFFILIATE_FEED_CDISCOUNT_FR_URL=
AFFILIATE_FEED_DARTY_FR_URL=
AFFILIATE_FEED_MEDIAMARKT_DE_URL=
AFFILIATE_FEED_SATURN_DE_URL=
AFFILIATE_FEED_OTTO_DE_URL=
AFFILIATE_FEED_ALTERNATE_DE_URL=
AFFILIATE_FEED_SAMSUNG_CA_URL=
SITE_MODE=live
PRODUCT_PROVIDER=unconfigured
LIVE_REFRESH_ENABLED=false
SUPPORTED_MARKETS=us,ca,uk,fr,de
REFRESH_CRON=15 0 * * *
OFFER_CHECK_CRON=45 3,9,15,21 * * *
OFFER_CHECK_ENABLED=true
STALE_OFFER_HOURS=48
MAX_PRODUCTS_PER_SOURCE=500
TIMEZONE=America/New_York
SEARCH_KEYWORDS=home gadgets,kitchen gadgets,car accessories,smart home,pet supplies,tools,travel accessories,office gadgets,fitness accessories,gifts under 25
# Transactional email (SendGrid)
SENDGRID_API_KEY=
PASSWORD_RESET_FROM_EMAIL=account@onedailydrop.com
EMAIL_FROM=account@onedailydrop.com
EMAIL_REPLY_TO=info@onedailydrop.com

# Payments (leave disabled until Club enrollment is opened)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLUB_PRICE_ID=
CLUB_ENROLLMENT_OPEN=false
